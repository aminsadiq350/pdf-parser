{
  "name": "notebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend-only PDF reader with AI chat.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "dompurify": "^3.4.11",
    "katex": "^0.16.47",
    "marked": "^9.1.6",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^3.11.174",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
